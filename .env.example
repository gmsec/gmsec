# 示例环境变量文件。复制为 .env(已在 .gitignore 中忽略)并按环境填写。
# 服务启动加载 conf/config.yml 后,仅当下面某个变量存在时才覆盖对应配置项。
# 生产请用密钥管理/编排平台注入,切勿把真实口令提交到仓库。

# MySQL 口令(覆盖 mysql_info.password)
GMSEC_DB_PASSWORD=

# Redis 口令(覆盖 redis_info.password)
GMSEC_REDIS_PASSWORD=

# Consul 地址(覆盖 consul_addr);留空表示不启用 consul 热更新
GMSEC_CONSUL_ADDR=

# Jaeger agent 地址(覆盖 jaeger.addr)
GMSEC_JAEGER_ADDR=

# CORS 允许的来源白名单,逗号分隔(不设置则不回显 Access-Control-Allow-Origin)
# 示例: https://admin.example.com,https://app.example.com
GMSEC_CORS_ALLOWED_ORIGINS=
